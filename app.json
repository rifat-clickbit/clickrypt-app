{
  "expo": {
    "name": "ClickRypt",
    "slug": "clickrypt-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clickrypt.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ClickRypt uses your camera to scan 2FA QR codes."
      }
    },
    "android": {
      "package": "com.clickrypt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1A"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ClickRypt to access camera to scan 2FA QR codes."
        }
      ]
    ]
  }
}
